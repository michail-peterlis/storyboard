{
  "name": "storyline",
  "version": "1.0.0",
  "description": "Offline, single-file interactive story editor and player.",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "check": "node scripts/check.mjs",
    "test": "node --test test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "test:browser": "node test/browser/run.mjs",
    "example": "node scripts/make-example.mjs",
    "verify": "npm run check && npm test && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "esbuild": "0.25.11",
    "husky": "^9.1.7",
    "playwright": "1.56.1"
  }
}
